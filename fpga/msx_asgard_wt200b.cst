// ===========================================================================
// msx_asgard_wt200b.cst
// Pinout para la placa WonderTANG 200b (version B del proyecto).
//
// Se conservan los NOMBRES DE SEÑAL de la WonderTANG en los pines; la
// traduccion a los nombres del proyecto se hace dentro de top_wt200b.v, a la
// salida del mp_debouncer.
//
// Diferencia principal con la placa propia: aqui las 16 lineas de direccion y
// los controles lentos (MREQ, IORQ, M1, RFSH, CS1, CS2, CS12, RESET) NO tienen
// pin. Llegan multiplexados por mp[7:0], con msel_n[2:0] habilitando uno de los
// tres 74LVC245 que comparten ese bus. RD, WR y SLTSL si son directos, que son
// los que necesitan llegar rapido.
// ===========================================================================

// --- reloj y botones -------------------------------------------------------
IO_LOC "clkin" 4;
IO_PORT "clkin" IO_TYPE=LVCMOS33;
IO_LOC "s1" 88;
IO_PORT "s1" IO_TYPE=LVCMOS33;
IO_LOC "s2" 87;
IO_PORT "s2" IO_TYPE=LVCMOS33;

// --- bus multiplexado de direcciones y control ------------------------------
IO_LOC "mp[0]" 77;
IO_PORT "mp[0]" IO_TYPE=LVCMOS33;
IO_LOC "mp[1]" 27;
IO_PORT "mp[1]" IO_TYPE=LVCMOS33;
IO_LOC "mp[2]" 28;
IO_PORT "mp[2]" IO_TYPE=LVCMOS33;
IO_LOC "mp[3]" 25;
IO_PORT "mp[3]" IO_TYPE=LVCMOS33;
IO_LOC "mp[4]" 26;
IO_PORT "mp[4]" IO_TYPE=LVCMOS33;
IO_LOC "mp[5]" 29;
IO_PORT "mp[5]" IO_TYPE=LVCMOS33;
IO_LOC "mp[6]" 30;
IO_PORT "mp[6]" IO_TYPE=LVCMOS33;
IO_LOC "mp[7]" 31;
IO_PORT "mp[7]" IO_TYPE=LVCMOS33;

IO_LOC "msel_n[0]" 17;
IO_PORT "msel_n[0]" IO_TYPE=LVCMOS33;
IO_LOC "msel_n[1]" 20;
IO_PORT "msel_n[1]" IO_TYPE=LVCMOS33;
IO_LOC "msel_n[2]" 19;
IO_PORT "msel_n[2]" IO_TYPE=LVCMOS33;

// --- bus de datos (bidireccional via 74LVC245) ------------------------------
IO_LOC "cd[0]" 48;
IO_PORT "cd[0]" IO_TYPE=LVCMOS33;
IO_LOC "cd[1]" 41;
IO_PORT "cd[1]" IO_TYPE=LVCMOS33;
IO_LOC "cd[2]" 86;
IO_PORT "cd[2]" IO_TYPE=LVCMOS33;
IO_LOC "cd[3]" 79;
IO_PORT "cd[3]" IO_TYPE=LVCMOS33;
IO_LOC "cd[4]" 72;
IO_PORT "cd[4]" IO_TYPE=LVCMOS33;
IO_LOC "cd[5]" 71;
IO_PORT "cd[5]" IO_TYPE=LVCMOS33;
IO_LOC "cd[6]" 53;
IO_PORT "cd[6]" IO_TYPE=LVCMOS33;
IO_LOC "cd[7]" 49;
IO_PORT "cd[7]" IO_TYPE=LVCMOS33;

// Direccion del 245 de datos: 0 = la FPGA conduce hacia el MSX. Pullup para que
// antes de configurarse la FPGA el buffer apunte HACIA la FPGA y el cartucho no
// ataque el bus del anfitrion.
IO_LOC "datadir" 52;
IO_PORT "datadir" PULL_MODE=UP IO_TYPE=LVCMOS33;

// --- control directo (entradas) ---------------------------------------------
IO_LOC "rd_n_in" 15;
IO_PORT "rd_n_in" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "wr_n_in" 16;
IO_PORT "wr_n_in" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC "sltsl_n_in" 18;
IO_PORT "sltsl_n_in" PULL_MODE=UP IO_TYPE=LVCMOS33;

// Reloj de 3.58 MHz del anfitrion: el MSX2+ genera el suyo con CLOCK_DIV, asi
// que no se usa.
IO_LOC "cpu_clkin" 76;
IO_PORT "cpu_clkin" IO_TYPE=LVCMOS33;

// --- salidas de la WonderTANG 2.00b que no usamos, pero hay que aparcar -----------
// Van al bus del MSX a traves de drivers, asi que dejarlas flotando puede
// colgar la maquina (WAIT) o corromper lecturas de otros cartuchos (BUSDIR).
// Los valores inactivos salen de su propio codigo:
//   wait_out  = ~wait_n            -> inactivo 0
//   int_out   = ~int_n             -> inactivo 0
//   busdir_n  = ... : 1'b1         -> inactivo 1
IO_LOC "wait_out" 42;
IO_PORT "wait_out" IO_TYPE=LVCMOS33;
IO_LOC "int_out" 73;
IO_PORT "int_out" IO_TYPE=LVCMOS33;
IO_LOC "busdir_n" 74;
IO_PORT "busdir_n" IO_TYPE=LVCMOS33;
IO_LOC "dac_smode_n" 51;
IO_PORT "dac_smode_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// --- usb uart (el puente va en el modulo Tang Nano, no en la placa) ---------
IO_LOC "usb_uart_tx" 69;
IO_PORT "usb_uart_tx"  IO_TYPE=LVCMOS33 DRIVE=4;

// --- flash ------------------------------------------------------------------
IO_LOC  "mspi_cs" 60;
IO_PORT "mspi_cs" IO_TYPE=LVCMOS33 DRIVE=4;
IO_LOC  "mspi_sclk" 59;
IO_PORT "mspi_sclk" IO_TYPE=LVCMOS33 DRIVE=4;
IO_LOC  "mspi_miso" 62;
IO_PORT "mspi_miso" IO_TYPE=LVCMOS33;
IO_LOC  "mspi_mosi" 61;
IO_PORT "mspi_mosi" IO_TYPE=LVCMOS33 DRIVE=4;

// --- sd card (modo SD de 1 bit) ---------------------------------------------
IO_LOC  "sd_sclk" 83;
IO_PORT "sd_sclk" IO_TYPE=LVCMOS33;
IO_LOC  "sd_cmd" 82;
IO_PORT "sd_cmd" IO_TYPE=LVCMOS33;
IO_LOC  "sd_dat0" 84;
IO_PORT "sd_dat0" IO_TYPE=LVCMOS33;
IO_LOC  "sd_dat3" 81;
IO_PORT "sd_dat3" IO_TYPE=LVCMOS33;
// DAT1 (85) y DAT2 (80) no se conducen: en modo 1 bit la tarjeta no los usa y
// quedan como pines sin declarar, que Gowin deja con pullup.
//IO_LOC  "sd_dat1" 85;
//IO_LOC  "sd_dat2" 80;

// --- hdmi -------------------------------------------------------------------
IO_LOC "tmds_data_p[0]" 35,36;
IO_PORT "tmds_data_p[0]" PULL_MODE=NONE DRIVE=4;
IO_LOC "tmds_data_p[1]" 37,38;
IO_PORT "tmds_data_p[1]" PULL_MODE=NONE DRIVE=4;
IO_LOC "tmds_data_p[2]" 39,40;
IO_PORT "tmds_data_p[2]" PULL_MODE=NONE DRIVE=4;
IO_LOC "tmds_clk_p" 33,34;
IO_PORT "tmds_clk_p" PULL_MODE=NONE DRIVE=4;

// access LED
//IO_LOC "led" 75;
//IO_PORT "led" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
